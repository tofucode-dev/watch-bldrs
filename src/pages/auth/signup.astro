---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="flex flex-1 items-center justify-center p-4 py-12">
    <div class="border-border bg-card shadow-paper w-full max-w-sm border p-8">
      <p class="font-script text-primary text-xl">Join the club</p>
      <h1 class="font-heading mt-1 mb-6 text-3xl font-extrabold tracking-tight uppercase">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Already have an account? <a href="/auth/signin" class="text-primary font-medium hover:underline">Sign in</a>
      </p>
    </div>
  </div>
</Layout>
