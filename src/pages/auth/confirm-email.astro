---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="flex flex-1 items-center justify-center p-4 py-12">
    <div class="border-border bg-card shadow-paper w-full max-w-sm border p-8 text-center">
      <p class="font-script text-primary text-xl">WatchBldrs</p>
      <h1 class="font-heading mt-1 mb-3 text-3xl font-extrabold tracking-tight uppercase">{content.heading}</h1>
      <p class="text-muted-foreground mb-6">{content.description}</p>
      <a
        href="/auth/signin"
        class="bg-primary font-heading text-primary-foreground hover:bg-primary/90 inline-flex px-4 py-2 text-sm font-bold tracking-[0.14em] uppercase"
      >
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
