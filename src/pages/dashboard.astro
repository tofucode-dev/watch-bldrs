---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="flex flex-1 items-center justify-center p-4 py-12">
    <div class="border-border bg-card shadow-paper w-full max-w-md border p-8 text-center">
      <p class="font-script text-primary text-xl">Your bench</p>
      <h1 class="font-heading mt-1 mb-4 text-3xl font-extrabold tracking-tight uppercase">Dashboard</h1>
      <p class="text-muted-foreground">
        Welcome, <span class="text-foreground font-semibold">{user?.email}</span>
      </p>
      <p class="text-muted-foreground mt-2 text-sm">This page is only for authenticated users.</p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="border-border bg-background font-heading hover:bg-muted border px-4 py-2 text-sm font-bold tracking-widest uppercase transition-colors"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
