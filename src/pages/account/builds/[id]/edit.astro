---
import Layout from "@/layouts/Layout.astro";
import { BuildForm, ownedDraftToFormInitial } from "@/modules/builds";
import { getOwnedDraftForForm } from "@/modules/builds/server";

const { id } = Astro.params;
const notFoundHeaders = { "Cache-Control": "private, no-store" };

if (!id) {
  return new Response(null, { status: 404, statusText: "Not Found", headers: notFoundHeaders });
}

const draft = await getOwnedDraftForForm(Astro.request, Astro.cookies, Astro.locals.user, id);

if (!draft) {
  return new Response(null, { status: 404, statusText: "Not Found", headers: notFoundHeaders });
}

Astro.response.headers.set("Cache-Control", "private, no-store");
---

<Layout title="Edit build">
  <BuildForm initialDraft={ownedDraftToFormInitial(draft)} client:load />
</Layout>
