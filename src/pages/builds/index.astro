---
import Layout from "@/layouts/Layout.astro";
import { CatalogFilterBar, CatalogListing } from "@/modules/catalog";
import { resolveCatalogListing } from "@/modules/catalog/server";

export const prerender = false;

const { state, filters } = await resolveCatalogListing(Astro.request, Astro.cookies);

if (state.status === "invalid-cursor" || state.status === "invalid-filter") {
  Astro.response.status = 400;
} else if (state.status === "unavailable") {
  Astro.response.status = 503;
}

Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout title="Builds">
  <CatalogFilterBar client:load initialFilters={filters} />
  <CatalogListing state={state} />
</Layout>
