---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: #e8e0d4;
    color: #1c1a16;
    border-color: #d6cdbf;
  }
  .banner--warning {
    background: #f4e7b0;
    color: #5c4a12;
    border-color: #c9a227;
  }
  .banner--error {
    background: #f4d6d0;
    color: #7f1d1d;
    border-color: #c1462e;
  }
</style>
